# Gitee PR Reviewer Configuration

# Flask服务器配置
PORT=5000
FLASK_DEBUG=0

# Gitee Webhook安全令牌
GITEE_WEBHOOK_SECRET=your_gitee_personal_access_token_here

# Gitee个人访问令牌（用于MCP API）
# 生成地址：https://gitee.com/profile/personal_access_tokens
GITEE_TOKEN=your_gitee_personal_access_token_here

# Gitee MCP 服务配置
GITEE_MCP_URL=http://localhost:8000/mcp
GITEE_MCP_AUTH_TOKEN=your_mcp_auth_token_here

# DeepSeek 模型配置
DEEPSEEK_MODEL=deepseek-chat

# Code Review 配置
REVIEW_PROMPT_PATH=resources/review_prompt.md
CODE_REVIEW_SKILL_URL=https://raw.githubusercontent.com/sanyuan0704/sanyuan-skills/refs/heads/main/skills/code-review-expert/SKILL.md

# HTTPS/SSL 配置（不配置则使用 HTTP）
SSL_CERT_PATH=
SSL_KEY_PATH=

# 日志级别
LOG_LEVEL=INFO


LANGSMITH_API_KEY=
LANGCHAIN_TRACING=true